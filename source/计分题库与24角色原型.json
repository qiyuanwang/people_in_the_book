    "4": "比较像我",
    "5": "非常像我"
  },
  "questions": [
    {
      "id": 1,
      "title": "人群里的启动",
      "text": "在人多的场合，我通常能比较自然地进入状态，有时还会主动带动一点气氛。",
      "dimension": "E",
      "reverse": false
    },
    {
      "id": 2,
      "title": "细微的波动",
      "text": "即使别人没有明说，我也常能察觉到他的情绪变化。",
      "dimension": "A",
      "reverse": false
    },
    {
      "id": 3,
      "title": "提前一页",
      "text": "重要的事情，我通常会提前准备，而不是等到最后一刻。",
      "dimension": "C",
      "reverse": false
    },
    {
      "id": 4,
      "title": "风浪来时",
      "text": "压力突然出现时，我通常还能保留基本的思考和行动能力。",
      "dimension": "S",
      "reverse": false
    },
    {
      "id": 5,
      "title": "陌生的门",
      "text": "新的观念、艺术形式或陌生世界，很容易勾起我的兴趣。",
      "dimension": "O",
      "reverse": false
    },
    {
      "id": 6,
      "title": "先在旁边看",
      "text": "在陌生场合，我更常先观察，等别人主动开口。",
      "dimension": "E",
      "reverse": true
    },
    {
      "id": 7,
      "title": "情绪距离",
      "text": "别人的烦恼通常不会太牵动我，我更习惯把注意力放在事情本身。",
      "dimension": "A",
      "reverse": true
    },
    {
      "id": 8,
      "title": "最后期限",
      "text": "如果没有外部催促，我常把任务拖到临近截止再处理。",
      "dimension": "C",
      "reverse": true
    },
    {
      "id": 9,
      "title": "反复回放",
      "text": "一件不愉快的小事，我可能在脑中反复回放很久。",
      "dimension": "S",
      "reverse": true
    },
    {
      "id": 10,
      "title": "抽象世界",
      "text": "哲思、隐喻或抽象概念通常让我觉得有些没必要。",
      "dimension": "O",
      "reverse": true
    },
    {
      "id": 11,
      "title": "交流补能",
      "text": "和不同的人交流、讨论或一起做事，通常会让我更有精神。",
      "dimension": "E",
      "reverse": false
    },
    {
      "id": 12,
      "title": "换一个位置",
      "text": "即使不同意一个人，我也会自然地想一想他为什么会那样感受。",
      "dimension": "A",
      "reverse": false
    },
    {
      "id": 13,
      "title": "把事情放回原位",
      "text": "我喜欢把任务、物品或计划处理得比较有秩序，并把该收尾的事情收完。",
      "dimension": "C",
      "reverse": false
    },
    {
      "id": 14,
      "title": "突发变化",
      "text": "计划突然被打乱时，我很容易一下子慌乱或被情绪带着走。",
      "dimension": "S",
      "reverse": true
    },
    {
      "id": 15,
      "title": "脑内世界",
      "text": "我的想象力比较活跃，经常会联想到故事、画面或不同的可能性。",
      "dimension": "O",
      "reverse": false
    },
    {
      "id": 16,
      "title": "被看见",
      "text": "如果可以选择，我通常不太想成为一群人注意力的中心。",
      "dimension": "E",
      "reverse": true
    },
    {
      "id": 17,
      "title": "争论时",
      "text": "在意见冲突里，我有时会太专注结论，而忘记照顾对方的感受。",
      "dimension": "A",
      "reverse": true
    },
    {
      "id": 18,
      "title": "收尾困难",
      "text": "我偶尔会把事情做到八九成，却忘记最后的整理、确认或归位。",
      "dimension": "C",
      "reverse": true
    },
    {
      "id": 19,
      "title": "恢复速度",
      "text": "大多数不愉快发生后，我能在相对有限的时间里重新回到自己的节奏。",
      "dimension": "S",
      "reverse": false
    },
    {
      "id": 20,
      "title": "熟悉就好",
      "text": "如果熟悉的方法一直有效，我通常不会主动去尝试新的做法。",
      "dimension": "O",
      "reverse": true
    }
  ],
  "clarifiers": [
    {
      "dimension": "E",
      "text": "连续一周已经很忙，周末恢复能量时，我仍更愿意和喜欢的人见面或参加一点活动。",
      "reverse": false
    },
    {
      "dimension": "A",
      "text": "意见不同的时候，我会自然留意自己的表达是否让对方难堪。",
      "reverse": false
    },
    {
      "dimension": "C",
      "text": "即使没有人监督，一个持续数周的任务我通常也能自己推进。",
      "reverse": false
    },
    {
      "dimension": "S",
      "text": "突发坏消息之后，我通常能够比较快恢复基本行动能力。",
      "reverse": false
    },
    {
      "dimension": "O",
      "text": "遇到陌生观点时，我更常先好奇它为什么成立，而不是立刻排斥。",
      "reverse": false
    }
  ],
  "scoring": {
    "reverse_formula": "6-response",
    "dimension_to_100": "(mean_item_score-1)/4*100",
    "match_formula": "0.70*((cosine_centered+1)/2)+0.30*(1-euclidean_distance/(100*sqrt(5)))",
    "confidence_gap": {
      "clear": 0.035,
      "composite": 0.015,
      "clarify_below": 0.015
    }
  },
